# Copiar a .env antes del primer arranque:  cp .env.example .env
# .env no se versiona. Cambiar las claves si el producto se expone fuera de la máquina local.

# --- Postgres del producto (solicitudes, predicciones, observaciones, reentrenamientos)
PRODUCTO_DB_USUARIO=novamercado
PRODUCTO_DB_CLAVE=novamercado
PRODUCTO_DB_NOMBRE=novamercado

# --- Postgres de Airflow (separado del producto)
AIRFLOW_DB_USUARIO=airflow
AIRFLOW_DB_CLAVE=airflow

# --- Airflow: usuario administrador (interfaz y API REST que usa /admin/reentrenar)
AIRFLOW_ADMIN_USUARIO=admin
AIRFLOW_ADMIN_CLAVE=admin
# Secreto para firmar los tokens JWT de la API de Airflow (cualquier texto largo)
AIRFLOW_JWT_SECRETO=cambiar-por-un-texto-largo-y-aleatorio
# Clave Fernet opcional (vacía = conexiones sin cifrar; suficiente para uso local)
AIRFLOW_FERNET_KEY=
# UID con el que corre Airflow (en Linux puede usarse el propio: id -u)
AIRFLOW_UID=50000

# --- Puertos en el anfitrión (dentro de la red de Docker no cambian)
# En macOS el 5000 lo ocupa AirPlay: usar 5001
MLFLOW_PUERTO_HOST=5000
AIRFLOW_PUERTO_HOST=8080
